{
  "expo": {
    "name": "Geniuzplus",
    "slug": "geniuz-entertainment",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "geniuz",
    "userInterfaceStyle": "dark",
    "icon": "./assets/new-logo/icon.png",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-video",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Geniuzplus uses your selected photo for your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/new-logo/splash-icon.png",
          "backgroundColor": "#020807",
          "imageWidth": 320,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/new-logo/splash-icon.png",
            "backgroundColor": "#020807"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geniuz.entertainment",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Geniuzplus uses your local network to send and receive videos between your devices."
      }
    },
    "android": {
      "package": "com.geniuz.entertainment",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#020807",
        "foregroundImage": "./assets/new-logo/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/new-logo/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecb9ecb7-36e5-4ab8-8ea1-cacf8f83dede"
      }
    },
    "owner": "geniuzlab57",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ecb9ecb7-36e5-4ab8-8ea1-cacf8f83dede",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
